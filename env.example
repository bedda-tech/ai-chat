# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# AI Gateway API Key (required for non-Vercel deployments)
# For Vercel deployments, OIDC tokens are used automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Application URL (used for Stripe redirects)
# For local development, defaults to http://localhost:3000 if not set
NEXT_PUBLIC_APP_URL=****

# Stripe API Keys
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=****
STRIPE_PUBLISHABLE_KEY=****

# Stripe Product Price IDs (monthly)
# Run `npx tsx scripts/setup-stripe.ts` with your STRIPE_SECRET_KEY to create these.
# Plans: Plus ($12/mo) | Pro ($25/mo) | Max ($50/mo)
STRIPE_PLUS_PRICE_ID=****
STRIPE_PRO_PRICE_ID=****
STRIPE_MAX_PRICE_ID=****

# Stripe Product Price IDs (annual — 20% discount)
STRIPE_PLUS_ANNUAL_PRICE_ID=****
STRIPE_PRO_ANNUAL_PRICE_ID=****
STRIPE_MAX_ANNUAL_PRICE_ID=****

# Stripe Team Seat Price ID (for Bedda for Teams workspace billing)
STRIPE_TEAM_SEAT_PRICE_ID=****

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=****

# Google Analytics 4 (optional)
# Get your Measurement ID from: https://analytics.google.com/ → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Umami Analytics (optional)
# Proxy host for Umami — if set, /a/script.js and /a/api/send are rewritten to this host
NEXT_PUBLIC_UMAMI_HOST=****

# Sentry Error Monitoring (optional but strongly recommended for production)
# Get your DSN from: https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=****
# Auth token for uploading source maps (CI/CD only)
# Get from: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=****
SENTRY_ORG=****
SENTRY_PROJECT=****
