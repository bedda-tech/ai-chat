# Bedda AI — Environment Variables
# Copy this file to .env.local and fill in your values.

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@host/dbname

# ─── Auth.js ─────────────────────────────────────────────────────────────────
AUTH_SECRET=your-random-secret-at-least-32-chars
AUTH_URL=http://localhost:3000

# ─── OAuth: Google ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth: GitHub ───────────────────────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PLUS_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_MAX_PRICE_ID=
STRIPE_MAX_ANNUAL_PRICE_ID=
STRIPE_TEAM_SEAT_PRICE_ID=   # Per-seat price for team subscriptions

# ─── AI / Gateway ────────────────────────────────────────────────────────────
# Vercel AI Gateway or individual provider keys (whichever your setup uses)

# ─── Storage ─────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Used for password reset emails
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=       # e.g. noreply@bedda.tech (must be a verified sender in Resend dashboard)

# ─── Web Search ──────────────────────────────────────────────────────────────
BRAVE_SEARCH_API_KEY=

# ─── Code Execution (E2B) ────────────────────────────────────────────────────
E2B_API_KEY=

# ─── Video Generation (fal.ai / Kling) ───────────────────────────────────────
# Get your key at https://fal.ai/dashboard/keys
FAL_API_KEY=

# ─── Cohere Reranking (optional — improves RAG result quality) ───────────────
COHERE_API_KEY=

# ─── Analytics (Umami) ───────────────────────────────────────────────────────
# Set to your publicly-accessible Umami server base URL to enable analytics rewrites.
# Leave unset to disable (Vercel prod cannot reach Tailscale-only hosts).
# Local dev example: NEXT_PUBLIC_UMAMI_HOST=https://media-server.tail0af452.ts.net:10000
NEXT_PUBLIC_UMAMI_HOST=

# ─── Slack Bot ("Bedda for Teams") ───────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps
# Enable Event Subscriptions → Request URL: <NEXT_PUBLIC_APP_URL>/api/slack/events
# Subscribe to bot events: app_mention, message.im
# Enable OAuth → Redirect URL: <NEXT_PUBLIC_APP_URL>/api/slack/callback
# Install URL: <NEXT_PUBLIC_APP_URL>/api/slack/install
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=        # From Slack app → Basic Information → Signing Secret
SLACK_BOT_TOKEN=             # Optional fallback token (single-workspace). Multi-workspace tokens stored in DB via OAuth.
SLACK_DEFAULT_MODEL=anthropic/claude-haiku-4.5   # Gateway model ID for Slack responses

# ─── Discord Bot ("Bedda for Discord") ───────────────────────────────────────
# Create a Discord application at https://discord.com/developers/applications
# Set Interactions Endpoint URL: <NEXT_PUBLIC_APP_URL>/api/discord/interactions
# Register /bedda slash command: node scripts/register-discord-commands.mjs
DISCORD_APP_ID=           # Application ID (General Information page)
DISCORD_PUBLIC_KEY=       # Public Key (General Information page) — Ed25519 signature verification
DISCORD_BOT_TOKEN=        # Bot Token (Bot page) — used to register slash commands
DISCORD_DEFAULT_MODEL=anthropic/claude-haiku-4.5   # Gateway model ID for Discord responses

# ─── GitHub Bot ("Bedda for GitHub") ─────────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
# Set Webhook URL: <NEXT_PUBLIC_APP_URL>/api/github/webhooks
# Subscribe to: Pull requests, Issues, Issue comments, Pull request review comments
# After installing the app, generate a token or use a PAT with repo scope
GITHUB_WEBHOOK_SECRET=        # Webhook secret set when creating the GitHub App
GITHUB_TOKEN=                 # GitHub App installation token or PAT with repo scope
GITHUB_AUTO_REVIEW=false      # Set to true to auto-review every opened PR
GITHUB_DEFAULT_MODEL=anthropic/claude-sonnet-4-6   # Gateway model ID for GitHub responses

# ─── Telegram Bot ("Bedda for Telegram") ─────────────────────────────────────
# Create a bot via @BotFather on Telegram: https://t.me/BotFather
# Set webhook: TELEGRAM_BOT_TOKEN=<token> node scripts/register-telegram-webhook.mjs
TELEGRAM_BOT_TOKEN=             # BotFather token (e.g. 123456789:ABC-DEF...)
TELEGRAM_WEBHOOK_SECRET=        # Random secret string for X-Telegram-Bot-Api-Secret-Token verification
TELEGRAM_DEFAULT_MODEL=anthropic/claude-haiku-4.5   # Gateway model ID for Telegram responses

# ─── Microsoft Teams Bot ("Bedda for Teams") ─────────────────────────────────
# Set up an Outgoing Webhook in your Teams channel:
#   Channel → Manage channel → Connectors → Outgoing Webhooks
#   Webhook URL: <NEXT_PUBLIC_APP_URL>/api/ms-teams/webhook
# Copy the generated security token and set it below (base64-encoded by Teams).
TEAMS_SECURITY_TOKEN=        # Security token from Teams Outgoing Webhook setup
TEAMS_DEFAULT_MODEL=google/gemini-2.0-flash-lite   # Fast model for sub-5s Teams responses

# ─── WhatsApp Cloud API ───────────────────────────────────────────────────────
# Setup: Meta Developer Portal → create app → add WhatsApp product → configure webhook
#   Webhook URL: <NEXT_PUBLIC_APP_URL>/api/whatsapp/webhook
#   Subscribed fields: messages
# Set WHATSAPP_VERIFY_TOKEN to any random string (used during webhook verification).
WHATSAPP_VERIFY_TOKEN=          # Random string for Meta webhook verification challenge
WHATSAPP_APP_SECRET=            # App secret from Meta app settings (for request signature verification)
WHATSAPP_ACCESS_TOKEN=          # Permanent system user access token or temporary test token
WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID from WhatsApp API setup (not the phone number itself)
WHATSAPP_DEFAULT_MODEL=anthropic/claude-haiku-4.5   # Gateway model ID for WhatsApp responses

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
